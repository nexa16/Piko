        }
      ]
    },
    {
      "name": "vocabulary_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_entries\" (\"id\" TEXT NOT NULL, \"collection_id\" TEXT NOT NULL REFERENCES collections (id) ON DELETE CASCADE, \"target_text\" TEXT NOT NULL, \"native_text\" TEXT NOT NULL, \"target_key\" TEXT NOT NULL, \"native_key\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK(length(trim(target_text)) > 0), CHECK(length(trim(native_text)) > 0), UNIQUE(collection_id, target_key, native_key));"
        }
      ]
    },
    {
      "name": "learning_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"learning_items\" (\"id\" INTEGER NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES vocabulary_entries (id) ON DELETE CASCADE, \"direction\" TEXT NOT NULL, \"format_version\" INTEGER NOT NULL, \"card_json\" TEXT NOT NULL, \"generation\" INTEGER NOT NULL DEFAULT 0 CHECK(generation >= 0), \"review_revision\" INTEGER NOT NULL DEFAULT 0 CHECK(review_revision >= 0), PRIMARY KEY (\"id\"), CHECK(id > 0), CHECK(direction IN ('targetToNative', 'nativeToTarget')), CHECK(format_version = 1), UNIQUE(entry_id, direction));"
        }
      ]
    },
    {
