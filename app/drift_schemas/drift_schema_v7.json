      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"regular_reviews\" (\"id\" TEXT NOT NULL, \"item_id\" INTEGER NOT NULL REFERENCES learning_items (id) ON DELETE CASCADE, \"generation\" INTEGER NOT NULL, \"reviewed_at\" TEXT NOT NULL, \"rating\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK(length(id) > 0), CHECK(generation >= 0), CHECK(rating IN ('again', 'hard', 'good')), CHECK(substr(reviewed_at, -1) = 'Z'));"
        }
      ]
    },
