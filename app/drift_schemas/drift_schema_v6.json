          "sql": "CREATE TABLE IF NOT EXISTS \"vocabulary_entries\" (\"id\" TEXT NOT NULL, \"collection_id\" TEXT NOT NULL REFERENCES collections (id) ON DELETE CASCADE, \"target_text\" TEXT NOT NULL, \"native_text\" TEXT NOT NULL, \"target_key\" TEXT NOT NULL, \"native_key\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK(length(trim(target_text)) > 0), CHECK(length(trim(native_text)) > 0), UNIQUE(collection_id, target_key, native_key));"
